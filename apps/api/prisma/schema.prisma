generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider    = "postgresql"
  url         = env("DATABASE_URL")
  directUrl   = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  WAITER
  CHEF
  CASHIER
  MANAGER
  ADMIN
}

enum TableStatus {
  FREE
  OCCUPIED
  BILL_REQUESTED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  RECEIVED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum ItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum Station {
  KITCHEN
  BAR
  COUNTER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  ONLINE
}

model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  phone        String?    @unique
  name         String
  passwordHash String
  role         Role       @default(CUSTOMER)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  orders       Order[]
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  menuItems   MenuItem[]
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  type          String
  value         Decimal   @db.Decimal(10, 2)
  minOrderValue Decimal?  @db.Decimal(10, 2)
  isActive      Boolean   @default(true)
  validFrom     DateTime?
  validTo       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
}

model DiningTable {
  id        String      @id @default(cuid())
  number    Int         @unique
  capacity  Int         @default(4)
  qrToken   String      @unique
  status    TableStatus @default(FREE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  orders    Order[]
}

model MenuItem {
  id            String        @id @default(cuid())
  name          String
  description   String?
  price         Decimal       @db.Decimal(10, 2)
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  isVeg         Boolean       @default(true)
  station       Station       @default(KITCHEN)
  taxPercent    Decimal       @default(5.0) @db.Decimal(5, 2)
  prepTimeMin   Int           @default(15)
  isAvailable   Boolean       @default(true)
  imageUrl      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  addons        Addon[]
  recipes       Recipe[]
  orderItems    OrderItem[]
}

model Addon {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Ingredient {
  id           String    @id @default(cuid())
  name         String    @unique
  unit         String
  stockQty     Decimal   @default(0) @db.Decimal(10, 2)
  reorderLevel Decimal   @default(0) @db.Decimal(10, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  recipes      Recipe[]
}

model Recipe {
  id           String     @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qtyUsed      Decimal    @db.Decimal(10, 2)

  @@unique([menuItemId, ingredientId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     Int           @default(autoincrement())
  tableId         String?
  table           DiningTable?  @relation(fields: [tableId], references: [id])
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  type            OrderType     @default(DINE_IN)
  status          OrderStatus   @default(PENDING)
  subtotal        Decimal       @db.Decimal(10, 2)
  taxAmount       Decimal       @db.Decimal(10, 2)
  discount        Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  couponId        String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  idempotencyKey  String?       @unique
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]
  payments        Payment[]
}

model OrderItem {
  id         String      @id @default(cuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id])
  quantity   Int
  unitPrice  Decimal     @db.Decimal(10, 2)
  taxPercent Decimal     @db.Decimal(5, 2)
  status     ItemStatus  @default(PENDING)
  station    Station     @default(KITCHEN)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  addons     OrderItemAddon[]
}

model OrderItemAddon {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addonName   String
  price       Decimal   @db.Decimal(10, 2)
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount            Decimal       @db.Decimal(10, 2)
  method            PaymentMethod @default(CARD)
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String
  createdAt DateTime @default(now())
}
